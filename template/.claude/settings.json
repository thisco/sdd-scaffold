{
  "permissions": {
    "ask": [
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(GEMINI.md)",
      "Edit(docs/adr/**)",
      "Edit(docs/constituicao/**)",
      "Edit(Arquitetura/mapa.yml)",
      "Write(AGENTS.md)",
      "Write(CLAUDE.md)",
      "Write(GEMINI.md)",
      "Write(docs/adr/**)",
      "Write(docs/constituicao/**)",
      "Write(Arquitetura/mapa.yml)",
      "Bash(sed -i:*)",
      "Bash(tee:*)"
    ],
    "deny": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.kiro/permissions.yaml)",
      "Edit(scripts/proteger_governanca.py)",
      "Edit(scripts/verificar_*.py)",
      "Edit(.github/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/settings.local.json)",
      "Write(.kiro/permissions.yaml)",
      "Write(scripts/proteger_governanca.py)",
      "Write(scripts/verificar_*.py)",
      "Write(.github/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/proteger_governanca.py\""
          }
        ]
      }
    ]
  }
}
